{
  "name": "umi-time",
  "version": "1.0.0",
  "description": "Umi‑Time: a JavaScript library implementing the Umi‑Time standard — a locally aware presentation of UTC — including umi conversion, formatting, and solar‑geometry helpers.",
  "author": "Daniel Brannon <contact@umitime.com> and Umi-Time contributors",
  "bugs": {
    "url": "https://github.com/umi-time/umi-time-js/issues",
    "email": "security@umitime.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umi-time/umi-time-js.git"
  },
  "homepage": "https://www.umitime.com/api",
  "keywords": [
    "umi-time",
    "umi",
    "utc",
    "time",
    "timekeeping",
    "astronomy",
    "solar",
    "planetary"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint src"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
